{#- DeepSeek-V4.1-Flash chat template (the official encoding.py's DSML head).

    This is the reference's V4.1 spaced generation, the one its own golden tests pin against
    encoding.py's test_output_1.txt: <｜System｜> once before the effort line when there is a system
    body or a tools prompt, every DSML tag opening with a space (<｜DSML｜ calls>, <｜DSML｜ invoke,
    <｜DSML｜ parameter), raw string parameters and json.dumps-shaped other values, one <｜User｜> shared
    by adjacent user-side blocks, and <｜end▁of▁sentence｜> at the end of each assistant turn.

    Thinking follows the engine's defaults (server_parse_chat.c): OFF unless the request asks for it,
    and effort HIGH when thinking is enabled without a named effort.  `reasoning_effort` takes the
    reference's spellings: none/off, low/medium/minimal (thinking on, no effort line), high/xhigh, max.
    `tools/dsv4/dsml_render.py` is this same render as a Python function, and
    `serve/test_chat_template_deepseek4.py` compares the two byte for byte.

    The model's own template is packed as `chat_template.jinja` next to its vocab.json
    (tools/strata_tokenizer.py extract writes it when the GGUF carries none). -#}
{%- set BOS = '<｜begin▁of▁sentence｜>' -%}
{%- set SYSTEM_TOKEN = '<｜System｜>' -%}
{%- set USER = '<｜User｜>' -%}
{%- set ASSISTANT = '<｜Assistant｜>' -%}
{%- set EOS = '<｜end▁of▁sentence｜>' -%}
{%- set IMAGE = '<｜deepseek_image｜>' -%}
{%- set THINK_START = '<think>' -%}
{%- set THINK_END = '</think>' -%}
{%- set CALLS_START = '<｜DSML｜ calls>' -%}
{%- set CALLS_END = '</｜DSML｜ calls>' -%}
{%- set INVOKE_START = '<｜DSML｜ invoke' -%}
{%- set INVOKE_END = '</｜DSML｜ invoke>' -%}
{%- set PARAM_START = '<｜DSML｜ parameter' -%}
{%- set PARAM_END = '</｜DSML｜ parameter>' -%}
{%- set THINK_HIGH_PREFIX = 'Reasoning Effort: 75 (range 1-100, the higher the value, the more thorough the reasoning)\n\n' -%}
{%- set THINK_MAX_PREFIX = 'Reasoning Effort: 100 (range 1-100, the higher the value, the more thorough the reasoning)\n\n' -%}
{%- set TOOLS_HEAD = '## Tools\n\n'
    ~ "You have access to a set of tools to help answer the user's question. "
    ~ 'You can invoke tools by writing a "' ~ CALLS_START ~ '" block like the following:\n\n'
    ~ CALLS_START ~ '\n'
    ~ INVOKE_START ~ ' name="$TOOL_NAME">\n'
    ~ PARAM_START ~ ' name="$PARAMETER_NAME" string="true|false">$PARAMETER_VALUE' ~ PARAM_END ~ '\n...\n'
    ~ INVOKE_END ~ '\n'
    ~ INVOKE_START ~ ' name="$TOOL_NAME2">\n...\n'
    ~ INVOKE_END ~ '\n'
    ~ CALLS_END ~ '\n\n'
    ~ 'String parameters should be specified as is and set `string="true"`. '
    ~ 'For all other types (numbers, booleans, arrays, objects), pass the value in JSON format and set `string="false"`.\n\n'
    ~ 'If thinking_mode is enabled (triggered by <think>), you MUST output your complete reasoning inside <think>...</think> BEFORE any tool calls or final response.\n\n'
    ~ 'Otherwise, output directly after </think> with tool calls or final response.\n\n'
    ~ '### Available Tool Schemas\n\n' -%}
{%- set TOOLS_TAIL = '\n\nYou MUST strictly follow the above defined tool name and parameter schemas to invoke tool calls.\n' -%}
{%- macro content_text(content, images=true) -%}
{%- if content is string -%}
{{- content -}}
{%- elif content is not none and content is iterable and content is not mapping -%}
{%- for item in content -%}
{%- if item is mapping and images and (item.type == 'image' or item.type == 'image_url' or item.type == 'input_image' or 'image' in item or 'image_url' in item) -%}
{{- IMAGE -}}
{%- elif item is mapping and 'text' in item -%}
{{- item.text -}}
{%- endif -%}
{%- endfor -%}
{%- endif -%}
{%- endmacro -%}
{%- macro attr(s) -%}
{{- s|string|replace('&', '&amp;')|replace('<', '&lt;')|replace('>', '&gt;')|replace('"', '&quot;') -}}
{%- endmacro -%}
{%- macro param(key, value) -%}
{{- PARAM_START -}}{{- ' name="' -}}{{- attr(key) -}}{{- '" string="' -}}
{%- if value is string -%}
{{- 'true">' -}}{{- value|replace(PARAM_END, '&lt;' ~ PARAM_END[1:]) -}}
{%- else -%}
{{- 'false">' -}}{{- (value|tojson)|replace(PARAM_END, '\\u003c' ~ PARAM_END[1:]) -}}
{%- endif -%}
{{- PARAM_END -}}
{%- endmacro -%}
{%- macro calls_text(message) -%}
{%- set cs = message.tool_calls -%}
{%- if cs is iterable and cs is not mapping and cs|length > 0 -%}
{{- '\n\n' -}}{{- CALLS_START -}}{{- '\n' -}}
{%- for call in cs -%}
{%- if not loop.first -%}{{- '\n' -}}{%- endif -%}
{%- set fn = call.function if call.function is defined else call -%}
{{- INVOKE_START -}}{{- ' name="' -}}{{- attr(fn.name) -}}{{- '">' -}}{{- '\n' -}}
{%- set args = fn.arguments if fn.arguments is defined else none -%}
{%- if args is mapping -%}
{%- for k, v in args|items -%}
{%- if not loop.first -%}{{- '\n' -}}{%- endif -%}
{{- param(k, v) -}}
{%- endfor -%}
{{- '\n' -}}
{%- else -%}
{{- param('arguments', args if args is string else args|tojson) -}}{{- '\n' -}}
{%- endif -%}
{{- INVOKE_END -}}
{%- endfor -%}
{{- '\n' -}}{{- CALLS_END -}}
{%- endif -%}
{%- endmacro -%}
{%- set think = false -%}
{%- set effort = '' -%}
{%- if enable_thinking is defined and enable_thinking is false -%}
{%- elif reasoning_effort is defined and reasoning_effort not in (none, '') -%}
{%- set re = reasoning_effort|string|lower -%}
{%- if re in ('none', 'off', 'false', 'disabled') -%}
{%- elif re in ('max', 'maximum') -%}
{%- set think = true -%}{%- set effort = THINK_MAX_PREFIX -%}
{%- elif re in ('high', 'xhigh') -%}
{%- set think = true -%}{%- set effort = THINK_HIGH_PREFIX -%}
{%- elif re in ('low', 'medium', 'minimal') -%}
{%- set think = true -%}
{%- else -%}
{{- raise_exception('Unexpected reasoning effort ' ~ reasoning_effort ~ '. Supported types are none, low, medium, high and max.') -}}
{%- endif -%}
{%- elif enable_thinking is defined and enable_thinking is true -%}
{%- set think = true -%}{%- set effort = THINK_HIGH_PREFIX -%}
{%- endif -%}
{%- set sys = namespace(text='') -%}
{%- for message in messages -%}
{%- if message.role == 'system' or message.role == 'developer' -%}
{%- if sys.text -%}{%- set sys.text = sys.text ~ '\n\n' -%}{%- endif -%}
{%- set sys.text = sys.text ~ content_text(message.content, false) -%}
{%- endif -%}
{%- endfor -%}
{%- set has_tools = tools is iterable and tools is not mapping and tools|length > 0 -%}
{%- set ctx = namespace(tool = has_tools) -%}
{%- set lu = namespace(idx=-1) -%}
{%- for message in messages -%}
{%- if message.role in ('user', 'tool', 'function') -%}{%- set lu.idx = loop.index0 -%}{%- endif -%}
{%- if message.role in ('tool', 'function') or (message.role == 'assistant' and message.tool_calls) -%}{%- set ctx.tool = true -%}{%- endif -%}
{%- endfor -%}
{{- BOS -}}
{%- if effort or sys.text or has_tools -%}{{- SYSTEM_TOKEN -}}{%- endif -%}
{{- effort -}}{{- sys.text -}}
{%- if has_tools -%}
{%- if sys.text -%}{{- '\n\n' -}}{%- endif -%}
{{- TOOLS_HEAD -}}
{%- for tool in tools -%}
{%- if not loop.first -%}{{- '\n' -}}{%- endif -%}
{{- tool|tojson -}}
{%- endfor -%}
{{- TOOLS_TAIL -}}
{%- endif -%}
{%- set st = namespace(pending=false, tool=false) -%}
{%- for message in messages -%}
{%- if message.role == 'system' or message.role == 'developer' -%}
{%- elif message.role == 'user' -%}
{%- if st.pending -%}{{- '\n\n' -}}{%- else -%}{{- USER -}}{%- endif -%}
{{- content_text(message.content, true) -}}
{%- set st.pending = true -%}{%- set st.tool = false -%}
{%- elif message.role == 'tool' or message.role == 'function' -%}
{%- if st.pending -%}{{- '\n\n' -}}{%- elif not st.tool -%}{{- USER -}}{%- endif -%}
{{- '<tool_result>' -}}{{- content_text(message.content, true)|replace('</tool_result>', '&lt;/tool_result>') -}}{{- '</tool_result>' -}}
{%- set st.pending = true -%}{%- set st.tool = true -%}
{%- elif message.role == 'assistant' -%}
{%- if st.pending -%}
{{- ASSISTANT -}}
{%- if think and (ctx.tool or loop.index0 > lu.idx) -%}
{{- THINK_START -}}{{- message.reasoning_content if message.reasoning_content is string else '' -}}{{- THINK_END -}}
{%- else -%}
{{- THINK_END -}}
{%- endif -%}
{%- endif -%}
{{- content_text(message.content, true) -}}
{{- calls_text(message) -}}
{{- EOS -}}
{%- set st.pending = false -%}{%- set st.tool = false -%}
{%- endif -%}
{%- endfor -%}
{%- if add_generation_prompt and st.pending -%}
{{- ASSISTANT -}}{%- if think -%}{{- THINK_START -}}{%- else -%}{{- THINK_END -}}{%- endif -%}
{%- endif -%}
